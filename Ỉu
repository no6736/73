class Rectangle:
    def __init__(self, width, height):
        self.width = width
        self.height = height

    def area(self):
        return self.width * self.height

    def perimeter(self):
        return (self.width + self.height) * 2

r1 = Rectangle(6, 4)
print(r1.area(), r1.perimeter())

r2 = Rectangle(3, 5)
print(r2.area(), r2.perimeter())
