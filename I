                            a.OutlineColor = Color3.fromRGB(255,255,160)
                        elseif h then
                            registerMapHighlight(h)
                        end
                    end
                end

                for _, obj in ipairs(MapCache.doorTriggers) do
                    if obj and obj.Parent and obj:FindFirstChild("ActionSign") then
                        local doorModel = obj.Parent
                        if doorModel then
                            local doorVisual = doorModel:FindFirstChild("Door") or doorModel
