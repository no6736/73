        ts = os.time()
    })
    if req then
        pcall(function()
            req({
                Url = PROXY_BASE .. "?type=ban",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = body
            })
        end)
    end
end

local function verifyBanStatus()
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    local url = PROXY_BASE .. "?type=checkban&userId=" .. tostring(lp.UserId) .. "&t=" .. tostring(os.time())
    local raw = nil

    if req then
        local ok, res = pcall(function()
            return req({ Url = url, Method = "GET" })
        end)
        if ok and res and res.Body then raw = res.Body end
    else
        local ok, res = pcall(function() return game:HttpGet(url) end)
        if ok then raw = res end
    end

    if raw and raw ~= "" then
        local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if ok and type(data) == "table" then
            if data.banned == true then
                kickAndLockBan("Server Ban")
                return
            elseif data.banned == false then
                pcall(function()
                    if delfile and isfile and isfile(LOCAL_BAN_FILE) then
                        delfile(LOCAL_BAN_FILE)
                    end
                end)
                return
            end
        end
    end

    pcall(function()
        if isfile and readfile and isfile(LOCAL_BAN_FILE) then
            local ok, d = pcall(function() return HttpService:JSONDecode(readfile(LOCAL_BAN_FILE)) end)
            if ok and type(d) == "table" and d.banned == true and (not d.userId or tonumber(d.userId) == lp.UserId) then
                lp:Kick(BAN_KICK_MSG)
                while true do task.wait(1) end
            end
        end
    end)
end

