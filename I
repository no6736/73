local function getViewportSize()
    local vp = SG.AbsoluteSize
    if vp.X <= 0 or vp.Y <= 0 then
        local cam = workspace.CurrentCamera
        vp = (cam and cam.ViewportSize) or Vector2.new(1920, 1080)
    end
    return vp
end

local function computeOptimalUIScale()
    local vp = getViewportSize()
    if isMobile() then
        -- Mobile / Tablet: fit comfortably within height while leaving breathing room
        local maxFitW = (vp.X * 0.86) / CFG.W
        local maxFitH = (vp.Y * 0.78) / CFG.H
        return math.clamp(math.min(maxFitW, maxFitH), 0.85, 1.18)
    else
        -- PC / Monitor: scale up so 480x320 becomes ~660x440 on 1080p (~41% of screen height, clear & easy to read, not fullscreen)
        local targetScaleH = (vp.Y * 0.42) / CFG.H
        local targetScaleW = (vp.X * 0.36) / CFG.W
        return math.clamp(math.min(targetScaleH, targetScaleW), 1.18, 1.85)
    end
end

