        while true do
            local fetchUrl = ADMIN_PROXY_URL .. "&t=" .. tostring(os.time()) .. "_" .. tostring(math.floor(os.clock() * 1000))
            local ok, raw = pcall(function()
                local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
                if req then
                    local res = req({
                        Url = fetchUrl,
                        Method = "GET"
                    })
                    if res and res.Body and (not res.StatusCode or res.StatusCode == 200) then
                        return res.Body
                    end
