            local msg = Instance.new("TextLabel", banner)
            msg.Size = UDim2.new(1, -20, 0, 26)
            msg.Position = UDim2.new(0, 10, 0, 28)
            msg.BackgroundTransparency = 1
            msg.Text = tostring(message)
            msg.TextColor3 = Color3.fromRGB(240, 240, 240)
            msg.Font = Enum.Font.GothamMedium
            msg.TextSize = 11
            msg.TextWrapped = true
            msg.TextXAlignment = Enum.TextXAlignment.Center

            pcall(function()
                local textChannels = TextChatService:FindFirstChild("TextChannels")
                local general = textChannels and textChannels:FindFirstChild("RBXGeneral")
                if general then
                    general:DisplaySystemMessage("<font color='#FF3333'><b>[ADMIN " .. sender .. "]:</b> " .. message .. "</font>")
                else
                    StarterGui:SetCore("ChatMakeSystemMessage", {
                        Text = "[ADMIN " .. sender .. "]: " .. message,
                        Color = Color3.fromRGB(255, 60, 60),
                        Font = Enum.Font.GothamBold,
                        FontSize = Enum.FontSize.Size18
                    })
                end
            end)

            local tweenIn = TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = UDim2.new(0.5, 0, 0, 25)
            })
            local tweenOut = TweenService:Create(banner, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                Position = UDim2.new(0.5, 0, 0, -90)
