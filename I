local function clampPanelCenter(cx, cy)
    local vp = getViewportSize()
    local s = PanelScale.Scale
    local halfW = (CFG.W * s) / 2
    local halfH = (CFG.H * s) / 2
    local minX = math.min(halfW + 8, vp.X / 2)
    local maxX = math.max(vp.X - halfW - 8, vp.X / 2)
    local minY = math.min(halfH + 8, vp.Y / 2)
    local maxY = math.max(vp.Y - halfH - 8, vp.Y / 2)
    return math.floor(math.clamp(cx, minX, maxX)), math.floor(math.clamp(cy, minY, maxY))
end

