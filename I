    local function firebaseGet(url)
        local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
        if req then
            local ok, res = pcall(function()
                return req({
                    Url = url,
                    Method = "GET"
                })
            end)
            if ok and res and res.Body then
                return true, res.Body
            end
        end
        return pcall(function()
            return game:HttpGet(url)
        end)
    end

    local function firebasePut(url, jsonBody)
        local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
        if req then
            local ok, res = pcall(function()
                return req({
                    Url = url,
                    Method = "PUT",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = jsonBody
                })
            end)
            if ok and res and (not res.StatusCode or (res.StatusCode >= 200 and res.StatusCode < 300)) then
                return true
            end
            local ok2, res2 = pcall(function()
                return req({
                    Url = url,
                    Method = "POST",
                    Headers = {
                        ["Content-Type"] = "application/json",
                        ["X-HTTP-Method-Override"] = "PUT"
                    },
                    Body = jsonBody
                })
            end)
            if ok2 and res2 then
                return true
            end
        end
        local ok3 = pcall(function()
            HttpService:PostAsync(url .. "?x-http-method-override=PUT", jsonBody, Enum.HttpContentType.ApplicationJson)
        end)
        return ok3
    end

    local function normalizeMessages(decoded)
        local list = {}
        if type(decoded) ~= "table" then return list end
        for _, v in pairs(decoded) do
            if type(v) == "table" and v.text and tostring(v.text) ~= "" then
                table.insert(list, {
                    id = tostring(v.id or (tostring(v.ts or 0) .. "_" .. tostring(v.userId or 0))),
                    userId = tonumber(v.userId) or 1,
                    name = tostring(v.name or "Player"),
                    text = tostring(v.text),
                    ts = tonumber(v.ts) or 0
                })
            end
        end
        table.sort(list, function(a, b)
            if a.ts == b.ts then
                return a.id < b.id
            end
            return a.ts < b.ts
        end)
        while #list > MAX_CHAT_HISTORY do
            table.remove(list, 1)
        end
        return list
    end

