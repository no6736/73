local wallQualifyCache = setmetatable({}, { __mode = "k" })

local IGNORED_WALL_KEYWORDS = {
    "prop", "decor", "book", "chair", "table", "shelf", "crate",
    "plant", "light", "lamp", "trash", "box", "paper", "bottle",
    "cup", "mug", "frame", "painting", "sign", "vent", "door",
    "trigger", "pod", "computer", "locker", "carpet", "rug", "bench",
    "couch", "sofa", "bed", "cabinet", "desk", "monitor", "keyboard"
}

local function hasIgnoredWallKeyword(str)
    if not str or str == "" then return false end
    local lower = string.lower(str)
    for _, kw in ipairs(IGNORED_WALL_KEYWORDS) do
        if string.find(lower, kw, 1, true) then
            return true
        end
    end
    return false
end

local function wallQualifies(p)
    if not p then return false end
    local cached = wallQualifyCache[p]
    if cached ~= nil then
        if cached and (not p.CanCollide or p.Transparency >= 0.95) then
            return false
        end
        return cached
    end

    if not p:IsA("Part") or p.Shape ~= Enum.PartType.Block then
        wallQualifyCache[p] = false
        return false
    end
    if not p.Anchored or not p.CanCollide or p.Transparency >= 0.95 or IsCharacterPart(p) then
        wallQualifyCache[p] = false
        return false
    end

    if hasIgnoredWallKeyword(p.Name) then
        wallQualifyCache[p] = false
        return false
    end
    local parent = p.Parent
    if parent and parent ~= workspace then
        if hasIgnoredWallKeyword(parent.Name) then
            wallQualifyCache[p] = false
            return false
        end
        local grandParent = parent.Parent
        if grandParent and grandParent ~= workspace and hasIgnoredWallKeyword(grandParent.Name) then
            wallQualifyCache[p] = false
            return false
        end
    end

    local cf = p.CFrame
    local rx, ry, rz = cf.RightVector, cf.UpVector, cf.LookVector
    local maxVerticalAxis = math.max(math.abs(rx.Y), math.abs(ry.Y), math.abs(rz.Y))
    if maxVerticalAxis < 0.92 then
        wallQualifyCache[p] = false
        return false
    end

    local sx, sy, sz = p.Size.X, p.Size.Y, p.Size.Z
    local worldX = math.abs(rx.X) * sx + math.abs(ry.X) * sy + math.abs(rz.X) * sz
    local worldY = math.abs(rx.Y) * sx + math.abs(ry.Y) * sy + math.abs(rz.Y) * sz
    local worldZ = math.abs(rx.Z) * sx + math.abs(ry.Z) * sy + math.abs(rz.Z) * sz

    local horizWidth = math.max(worldX, worldZ)
    local horizThick = math.min(worldX, worldZ)

    local isWallGeometry = (worldY >= 1.5)
        and (horizWidth >= 3.0)
        and (horizThick <= 4.5)
        and (horizWidth * worldY >= 14.0)
        and not (worldX > 14 and worldZ > 14 and worldY < 5)

    wallQualifyCache[p] = isWallGeometry
    return isWallGeometry
end

local function scanFullMap()
    local cm = Replicated:FindFirstChild("CurrentMap")
    local map = cm and cm.Value
    if not map or not map.Parent then return end

    for p in pairs(WallhopView.cachedParts) do
        if not p.Parent then WallhopView.cachedParts[p] = nil end
    end

    local n = 0
    for _, p in ipairs(map:GetDescendants()) do
        if not WallhopView.enabled or not WallhopView.maxMode then return end
        if wallQualifies(p) and not WallhopView.cachedParts[p] then
            AddOutline(p); WallhopView.cachedParts[p] = true
        end
        n = n + 1
        if n % 150 == 0 then task.wait() end
    end
end

function WallhopView.start()
    if WallhopView.enabled then return end
    WallhopView.enabled = true

    if WallhopView.maxMode then
        local t = task.spawn(function()
            local cm = Replicated:WaitForChild("CurrentMap")
            local lastMap = cm.Value
            if lastMap then scanFullMap() end

            table.insert(WallhopView.connections, cm.Changed:Connect(function()
                local map = cm.Value
                if not map or map == lastMap then return end
                lastMap = map
                task.spawn(function()
                    task.wait(3)
                    if cm.Value == map and WallhopView.enabled and WallhopView.maxMode then
                        scanFullMap()
                    end
                end)
            end))
        end)
        table.insert(WallhopView.connections, t)
        return
    end

    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    local t = task.spawn(function()
        while task.wait(SCAN_DELAY) do
            if not WallhopView.enabled then break end
            local hrp = GetHRP()
            if not hrp then continue end
            op.FilterDescendantsInstances = {lp.Character}
            local parts = workspace:GetPartBoundsInRadius(hrp.Position, WallhopView.radius, op)
            local seen = {}
            for _, p in ipairs(parts) do
                if wallQualifies(p) then
                    seen[p] = true
                    if not WallhopView.cachedParts[p] then AddOutline(p); WallhopView.cachedParts[p] = true end
                end
            end
            for p in pairs(WallhopView.cachedParts) do
                if not seen[p] or not p.Parent then RemoveOutline(p); WallhopView.cachedParts[p] = nil end
            end
        end
    end)
    table.insert(WallhopView.connections, t)
end

function WallhopView.setRange(v)
    if WallhopView.maxMode and v <= 100 then
        WallhopView.maxMode = false
        WallhopView.radius = v
        if WallhopView.enabled then
            WallhopView.stop()
            WallhopView.start()
        end
    else
        WallhopView.maxMode = false
        WallhopView.radius = v
    end
end

function WallhopView.stop()
    WallhopView.enabled = false
    for _, c in pairs(WallhopView.connections) do
        if typeof(c)=="thread" then pcall(task.cancel, c)
        elseif typeof(c)=="RBXScriptConnection" then c:Disconnect() end
    end
    WallhopView.connections = {}
    for p in pairs(WallhopView.cachedParts) do RemoveOutline(p) end
    WallhopView.cachedParts = {}
end

