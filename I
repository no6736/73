            if MyHub.Config.ESP.player and updateSinglePlayerESP then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= lp then
                        updateSinglePlayerESP(p, false)
                    end
                end
            end
        end)
    end)
