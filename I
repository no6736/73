            local parent = getGuiParent()
            local old = parent:FindFirstChild("AdminSlideBannerUI")
            if old then old:Destroy() end

            local sg = Instance.new("ScreenGui")
            sg.Name = "AdminSlideBannerUI"
            sg.ResetOnSpawn = false
