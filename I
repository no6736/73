        return false
    end

    local function checkAndResetIfCaptured()
        if not MyHub.Config.AntiCapture or isResetting then return end

        local capturedNow = isLocalPlayerCaptured()
        if not capturedNow then
            waitingForClear = false
            return
        end

        -- Chờ game cập nhật lại dữ liệu sau khi vừa respawn hoặc vừa reset lần 1
        if waitingForClear then return end
        if os.clock() - lastSpawnClock < 2.5 then return end
        if os.clock() - lastResetClock < 6.0 then return end

        local char = lp.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            isResetting = true
            waitingForClear = true
            lastResetClock = os.clock()
            hum.Health = 0
            task.spawn(function()
                task.wait(3.0)
                isResetting = false
            end)
        end
    end

    function MyHub.AntiCapture.start()
        if hbConn then hbConn:Disconnect(); hbConn = nil end
        if charConn then charConn:Disconnect(); charConn = nil end
        isResetting = false
        waitingForClear = false
        charConn = lp.CharacterAdded:Connect(function()
            lastSpawnClock = os.clock()
            isResetting = true
            task.wait(2.5)
            isResetting = false
        end)
        hbConn = RunService.Heartbeat:Connect(checkAndResetIfCaptured)
        checkAndResetIfCaptured()
    end

    function MyHub.AntiCapture.stop()
        if hbConn then hbConn:Disconnect(); hbConn = nil end
        if charConn then charConn:Disconnect(); charConn = nil end
        isResetting = false
        waitingForClear = false
    end
end


local _unlockedAdminKey = nil
local function _verifySecretHash(str)
    if type(str) ~= "string" or #str == 0 then return false end
    local h = 5381
    for i = 1, #str do
        h = (h * 33 + string.byte(str, i)) % 2147483647
    end
    return h == 789910215
end

local function _extractAdminKey(rawInput)
    if type(rawInput) ~= "string" then return nil end
    local trimmed = rawInput:gsub("^%s+", ""):gsub("%s+$", "")
    local cmdArg = trimmed:match("^[/!]admin%s+(.+)$") or trimmed:match("^[/!]bc%s+(.+)$") or trimmed
    if _verifySecretHash(cmdArg) then
        return cmdArg
    end
    return nil
end

