local function disconnectBlackFogConns()
    if BlackFog.conn then BlackFog.conn:Disconnect(); BlackFog.conn = nil end
    for _, c in ipairs(BlackFog.connections) do
        if typeof(c) == "RBXScriptConnection" then c:Disconnect() end
    end
    BlackFog.connections = {}
end

function BlackFog.start()
    if BlackFog.enabled or BlackFog.locked then return end
    BlackFog.enabled = true
    disconnectBlackFogConns()

    local black = Color3.fromRGB(0, 0, 0)

    local function bindAtmosphere(atm)
        if not atm or not atm:IsA("Atmosphere") then return end
        if not BlackFog.original or not BlackFog.original.atm or not BlackFog.original.atm.Parent then
            BlackFog.original = {
                atm = atm, Color = atm.Color, Decay = atm.Decay,
                Glare = atm.Glare, Haze = atm.Haze,
            }
        end
        local function applyBlack()
            if not BlackFog.enabled or not atm.Parent then return end
            if atm.Color ~= black then atm.Color = black end
            if atm.Decay ~= black then atm.Decay = black end
            if atm.Glare ~= 0 then atm.Glare = 0 end
            if atm.Haze ~= 0 then atm.Haze = 0 end
        end
        applyBlack()
        table.insert(BlackFog.connections, atm:GetPropertyChangedSignal("Color"):Connect(applyBlack))
        table.insert(BlackFog.connections, atm:GetPropertyChangedSignal("Decay"):Connect(applyBlack))
        table.insert(BlackFog.connections, atm:GetPropertyChangedSignal("Glare"):Connect(applyBlack))
        table.insert(BlackFog.connections, atm:GetPropertyChangedSignal("Haze"):Connect(applyBlack))
    end

    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
    if atm then bindAtmosphere(atm) end

    table.insert(BlackFog.connections, Lighting.ChildAdded:Connect(function(ch)
        if BlackFog.enabled and ch:IsA("Atmosphere") then
            bindAtmosphere(ch)
        end
    end))
end

function BlackFog.stop()
    BlackFog.enabled = false
    disconnectBlackFogConns()
    local o = BlackFog.original
    BlackFog.original = nil
    if o and o.atm and o.atm.Parent then
        o.atm.Color = o.Color
        o.atm.Decay = o.Decay
        o.atm.Glare = o.Glare
        o.atm.Haze = o.Haze
    end
end

local function disconnectFogDensityConns()
    if FogDensity.conn then FogDensity.conn:Disconnect(); FogDensity.conn = nil end
    for _, c in ipairs(FogDensity.connections) do
        if typeof(c) == "RBXScriptConnection" then c:Disconnect() end
    end
    FogDensity.connections = {}
end

function FogDensity.set(v)
    FogDensity.value = v
    if BlackFog.locked then return end

    local currentAtm = Lighting:FindFirstChildOfClass("Atmosphere")
    if FogDensity.active then
        if currentAtm and currentAtm.Density ~= FogDensity.value then
            currentAtm.Density = FogDensity.value
        end
        return
    end

    FogDensity.active = true
    disconnectFogDensityConns()

    local function bindAtmosphere(atm)
        if not atm or not atm:IsA("Atmosphere") then return end
        if not FogDensity.original or not FogDensity.original.atm or not FogDensity.original.atm.Parent then
            FogDensity.original = {atm = atm, Density = atm.Density}
        end
        local function applyDensity()
            if not FogDensity.active or not atm.Parent then return end
            if atm.Density ~= FogDensity.value then
                atm.Density = FogDensity.value
            end
        end
        applyDensity()
        table.insert(FogDensity.connections, atm:GetPropertyChangedSignal("Density"):Connect(applyDensity))
    end

    if currentAtm then bindAtmosphere(currentAtm) end

    table.insert(FogDensity.connections, Lighting.ChildAdded:Connect(function(ch)
        if FogDensity.active and ch:IsA("Atmosphere") then
            bindAtmosphere(ch)
        end
    end))
end

function FogDensity.stop()
    FogDensity.active = false
    disconnectFogDensityConns()
    local o = FogDensity.original
    FogDensity.original = nil
    if o and o.atm and o.atm.Parent then o.atm.Density = o.Density end
end

local ShiftLockMobile = {enabled=false, connections={}, renderConn=nil, gui=nil, locked=false}

local DRAG_THRESHOLD = 5

local function applyShiftLockState(icon)
    local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
    pcall(function()
        if ShiftLockMobile.locked then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
            UserInputService.MouseIconEnabled = false
            if hum then hum.AutoRotate = false end
            if icon then icon.ImageColor3 = Color3.fromRGB(255,150,60) end

            if ShiftLockMobile.renderConn then ShiftLockMobile.renderConn:Disconnect() end
            ShiftLockMobile.renderConn = RunService.RenderStepped:Connect(function()
                local char = lp.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                local h = char and char:FindFirstChildOfClass("Humanoid")
                if not root or not h or h.Health <= 0 then return end
                if h:GetState() == Enum.HumanoidStateType.Ragdoll then return end

                local cam = workspace.CurrentCamera
                local look = cam.CFrame.LookVector
                look = Vector3.new(look.X, 0, look.Z)
                if look.Magnitude < 0.01 then return end
                look = look.Unit

                local targetCFrame = CFrame.new(root.Position, root.Position + look)
                root.CFrame = CFrame.new(root.Position) * (targetCFrame - targetCFrame.Position)
            end)
        else
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            UserInputService.MouseIconEnabled = true
            if hum then hum.AutoRotate = true end
            if icon then icon.ImageColor3 = Color3.new(1,1,1) end

            if ShiftLockMobile.renderConn then
                ShiftLockMobile.renderConn:Disconnect()
                ShiftLockMobile.renderConn = nil
            end
        end
    end)
end

local function createShiftLockIcon()
    local gui = Instance.new("ScreenGui")
    gui.Name = "ShiftLockMobileUI"; gui.Parent = pgui; gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true

    local icon = Instance.new("ImageButton")
