                for _, obj in ipairs(MapCache.pods) do
                    if obj and obj.Parent then
                        local h = obj:FindFirstChildOfClass("Highlight")
                        if h and not MyHub.Config.ESP.pods then h.Adornee = nil; h:Destroy()
