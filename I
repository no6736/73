    pcall(function() ShiftLockMobile.stop() end)
    pcall(function() SelfMuting.stop() end)
    MyHub.Config.AntiCapture = false
    pcall(function() MyHub.AntiCapture.stop() end)

    if MyHub.Config.NoTexture then
        MyHub.Config.NoTexture = false
        pcall(restoreMap)
    end

    MyHub.Config.ESP.player = false
    MyHub.Config.ESP.pods = false
    MyHub.Config.ESP.pc = false
    MyHub.Config.ESP.exits = false
    MyHub.Config.ESP.lockers = false
    MyHub.Config.ESP.vents = false

    if _G.__ExFTF_CleanupPlayerESP then
        pcall(_G.__ExFTF_CleanupPlayerESP)
    end
    if clearAllPlayerESP then
        pcall(clearAllPlayerESP)
    end

    pcall(updateVentESP)
    pcall(function()
        for _, part in ipairs(MapCache.vents) do
            if part and part.Parent then
                for _, child in ipairs(part:GetChildren()) do
                    if child:IsA("SurfaceGui") and child.Name == "VentHL" then
                        child:Destroy()
                    end
                end
            end
        end
    end)

    pcall(function()
        for i = #TrackedMapHighlights, 1, -1 do
            local hl = TrackedMapHighlights[i]
            if hl and hl.Parent then
                hl.Adornee = nil
                hl:Destroy()
            end
            TrackedMapHighlights[i] = nil
        end

        for _, list in ipairs({MapCache.computers, MapCache.pods, MapCache.exits}) do
            for _, obj in ipairs(list) do
                if obj and obj.Parent then
                    local h = obj:FindFirstChildOfClass("Highlight")
                    if h then h.Adornee = nil; h:Destroy() end
                end
            end
        end

        for _, obj in ipairs(MapCache.doorTriggers) do
            if obj and obj.Parent then
                local doorModel = obj.Parent
                local doorVisual = doorModel:FindFirstChild("Door") or doorModel
                local h = doorVisual and doorVisual:FindFirstChildOfClass("Highlight")
                if h then h.Adornee = nil; h:Destroy() end
            end
        end

        local CollectionService = game:GetService("CollectionService")
        for _, locker in ipairs(CollectionService:GetTagged("LOCKER")) do
            if locker and locker.Parent then
                local h = locker:FindFirstChildOfClass("Highlight")
                if h then h.Adornee = nil; h:Destroy() end
            end
        end
    end)

    pcall(function() MapCache.stop() end)
end

