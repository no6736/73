    local function hackPC(pcData)
        if not pcData or not pcData.computer or #pcData.triggers == 0 then return false end

        local id = pcData.id
        local tag = "PC" .. tostring(id)

        if screenDone(pcData.computer) or getPCProgress(pcData) >= 1 then
            S.hacked[id] = true
            return true
        end

        if shouldAbortForExit() then return false end

        local b = findCurrentBeast()
        if b and b.Character then
            local br = b.Character:FindFirstChild("HumanoidRootPart") or torsoOf(b.Character)
            local pPart = partOf(pcData.computer)
            if br and pPart and (br.Position - pPart.Position).Magnitude <= CFG.beastEvadeDist then
                S.skipped[id] = true
                return false
            end
        end

        local chosen
        for i, trigger in ipairs(pcData.triggers) do
            if S.saving or shouldAbortForExit() then
                cancelCurrentTween()
                return false
            end
            waitUnpaused()
            moveToTrigger(trigger, i > 1)
            if S.saving or S.cancelMove or shouldAbortForExit() then
                if S.cancelMove then S.skipped[id] = true end
                cancelCurrentTween()
                return false
            end

            if isBeastNearby(CFG.beastEvadeDist) then
                S.skipped[id] = true
                escapeBeast()
                return false
            end

            S.currentTrigger = trigger
            S.canJump = true

            local before = myProgress()
            local root = getRoot()
            local trigEvent = trigger:FindFirstChild("Event")
            if root then touch(root, trigger, 0.03) end

            for _ = 1, 3 do
                if trigEvent then fire("Input", "Trigger", true, trigEvent) end
                action()
                local st = player:FindFirstChild("TempPlayerStatsModule")
                local anim = st and st:FindFirstChild("CurrentAnimation")
                if anim and tostring(anim.Value) == "Typing" then break end
                task.wait(0.033)
            end

            for _ = 1, 8 do
                while S.saving and alive and S.enabled do
                    task.wait(0.1)
                end
                if shouldAbortForExit() then
                    cancelCurrentTween()
                    return false
                end
                if isBeastNearby(CFG.beastEvadeDist) then
                    S.skipped[id] = true
                    escapeBeast()
                    return false
                end
                local st = player:FindFirstChild("TempPlayerStatsModule")
                local anim = st and st:FindFirstChild("CurrentAnimation")
                if myProgress() > before + 0.001 or (anim and tostring(anim.Value) == "Typing") then
                    break
                end
                task.wait(0.1)
                if not S.paused and not S.saving then
                    if trigEvent then fire("Input", "Trigger", true, trigEvent) end
                    action()
                end
            end

            local stats = player:FindFirstChild("TempPlayerStatsModule")
            local anim = stats and stats:FindFirstChild("CurrentAnimation")
            local isTyping = anim and tostring(anim.Value) == "Typing"

            if myProgress() > before + 0.001 or isTyping then
                chosen = trigger
                break
            end
            S.canJump = false
            S.currentTrigger = nil
        end

        if not chosen then
            S.moving = false
            stopHack()
            return false
        end

        S.hacking = true
        S.currentPC = pcData
        setStatus("Hacking " .. tag)

        local lastProg, stuck = 0, 0
        local sawValidProg = (myProgress() < 0.95)
        while S.hacking and S.enabled and not S.gameOver and alive do
            task.wait(0.1)

            if shouldAbortForExit() then
                cancelCurrentTween()
                return false
            end

            if S.paused or S.saving then
                S.jumpTimer = 0
                continue
            end

            if not isInRound() then
                S.moving = false
                stopHack()
                return false
            end

            if isBeastNearby(CFG.beastEvadeDist) and not S.saving then
                S.skipped[id] = true
                escapeBeast()
                return false
            end

            local pc = pcData.computer
            if not pc or not pc.Parent then break end

            action()
            local prog = myProgress()
            if prog < 0.95 then
                sawValidProg = true
            end

            if prog == lastProg then
                stuck += 1
                if stuck > 12 then
                    local trigEvt = chosen and chosen:FindFirstChild("Event")
                    for attempt = 1, 3 do
                        if trigEvt then fire("Input", "Trigger", true, trigEvt) end
                        action()
                        local st = player:FindFirstChild("TempPlayerStatsModule")
                        local anim = st and st:FindFirstChild("CurrentAnimation")
                        if anim and tostring(anim.Value) == "Typing" then break end
                        if attempt < 3 then task.wait(0.033) end
                    end
                    stuck = 0
                end
            else
                stuck = 0
            end
            lastProg = prog

            local sc = pc:FindFirstChild("SkillCheckActive")
            if sc and sc.Value then fire("SkillCheck", true) end

            if screenDone(pc) or (sawValidProg and prog >= 0.999) then
                setStatus("Done " .. tag)
                S.hacked[id] = true
                S.hacked[pc] = true
                stopHack()
                S.pcs = findAllPCs()
                return true
            end
        end

        stopHack()
        return false
    end

    -- ======================================================== AUTO EXIT

    local function exitSolidCount(e)
        local n = 0
        for _, p in ipairs(e.model:GetDescendants()) do
            if p:IsA("BasePart") and p ~= e.trigger and p ~= e.area
                and not p.Name:find("Trigger") and not p.Name:find("Area") and p.CanCollide then
                n += 1
            end
        end
        return n
    end

    local function exitFindAll()
        local list = {}
        local map = getMap()
        if not map then return list end
        for _, obj in ipairs(MapCache.exits) do
            if obj and obj.Parent and (obj:IsA("Model") or obj:IsA("Folder")) then
                local e = Exit.cache[obj]
                if not e then
                    local trigInst = obj:FindFirstChild("ExitDoorTrigger", true)
                    local areaInst = obj:FindFirstChild("ExitArea", true)
                    local trig = partOf(trigInst)
                    if trig then
                        e = {
                            model = obj, trigger = trig,
                            area = partOf(areaInst) or trig,
                            sign = trigInst and trigInst:FindFirstChild("ActionSign"),
                        }
                        e.solid0 = exitSolidCount(e)
                        Exit.cache[obj] = e
                    end
                end
                if e then list[#list + 1] = e end
            end
        end
        return list
    end

    local function exitIsOpen(e)
        local solid = exitSolidCount(e)
        if e.solid0 and e.solid0 > 0 and solid < e.solid0 then return true end
        local dp = partOf(e.model:FindFirstChild("Door", true))
        if dp and (dp.Transparency > 0.5 or not dp.CanCollide) then return true end
        if e.sign and e.sign.Parent and e.sign.Value == 11 then return true end
        return false
    end

    local function playerNear(part, dist)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local root = p.Character:FindFirstChild("HumanoidRootPart")
                if root and (root.Position - part.Position).Magnitude <= dist then return p end
            end
        end
        return nil
    end

    local function playerProgress(plr)
        local stats = plr:FindFirstChild("TempPlayerStatsModule")
        local ap = stats and stats:FindFirstChild("ActionProgress")
        return ap and ap.Value or 0
    end

    local function exitOpenDoor(e)
        local trig = e.trigger
        if not trig or not trig.Parent then return "timeout" end
        local trigEvt = trig:FindFirstChild("Event")
        local result = "timeout"

        withNoclip(function()
            local root = getRoot()
            if root then
                zeroVelocity(root)
                root.CFrame = trig.CFrame
            end

            -- Dính chặt tuyệt đối vào tâm ExitDoorTrigger mỗi khung hình (RenderStepped + Heartbeat) cho tới khi cửa mở
            local pin = true
            local function lockToTrigger()
                if not pin or S.paused or S.evading then return end
                local r = getRoot()
                if r and trig and trig.Parent then
                    r.CFrame = trig.CFrame
                    zeroVelocity(r)
                end
            end
            local stepConn = RunService.RenderStepped:Connect(lockToTrigger)
            local hbConn = RunService.Heartbeat:Connect(lockToTrigger)

            task.wait(0.1)
            local r0 = getRoot()
            if r0 then
                touch(r0, trig, 0.05)
            end
            if trigEvt then
                fire("Input", "Trigger", true, trigEvt)
            end
            action()

            local waited = 0
            local lastTouch = os.clock()
            while alive and S.enabled and not S.escaped and waited < 25 do
                task.wait(0.12)
                if S.paused then continue end
                waited += 0.12

                if isBeastNearby(35) then
                    pin = false
                    escapeBeast()
                    result = "beast"
                    break
                end

                if exitIsOpen(e) then
                    result = "open"
                    break
                end

                local other = playerNear(trig, 8)
                local prog = other and playerProgress(other) or myProgress()
                if prog >= 0.999 then
                    task.wait(0.25)
                    result = "open"
                    break
                end

                if not other then
                    local r = getRoot()
                    if r and (os.clock() - lastTouch >= 0.6 or prog <= 0.001) then
                        lastTouch = os.clock()
                        pcall(function()
                            firetouchinterest(r, trig, 0)
                            firetouchinterest(r, trig, 1)
                        end)
                    end
                    if trigEvt then
                        fire("Input", "Trigger", true, trigEvt)
                    end
                    action()
                end
            end

            pin = false
            stepConn:Disconnect()
            hbConn:Disconnect()

            if trigEvt then
                fire("Input", "Trigger", false, trigEvt)
            end
            fire("Input", "Action", false)
        end)

        return result
    end

    local function exitEscape(e)
        local root = getRoot()
        if not root then return false end

        S.escaping = true
        local hum = getHum()
        local my = root.Position
        root.CFrame = CFrame.new(my.X, my.Y - 80, my.Z)
        if hum then
            hum.PlatformStand = true
            hum:ChangeState(Enum.HumanoidStateType.Physics)
        end

        local freezing = true
        local c = RunService.Heartbeat:Connect(function()
            if freezing then pcall(zeroVelocity, root) end
        end)
        task.wait(1.5)
        freezing = false
        c:Disconnect()

        root.CFrame = e.area.CFrame + Vector3.new(0, 2, 0)
        task.wait(0.3)
        if hum then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end

        local ok = false
        for _ = 1, 50 do
            task.wait(0.2)
            if hasPlayerEscaped() or not isPlayerInMatch(player) then ok = true break end
        end
        S.escaping = false
        return ok
    end

    local function runAutoExit()
        local startRound = S.round
        local t0 = tick()
        local tried = {}

        while alive and S.enabled and not S.escaped and S.round == startRound and tick() - t0 < 240 do
            task.wait(0.2)
            if S.paused then continue end

            if hasPlayerEscaped() or not isInRound() then
                S.escaped = true
                return
            end

            if not isFindExitPhase() then
                task.wait(0.3)
                continue
            end

            local exits = exitFindAll()
            if #exits == 0 then
                task.wait(0.5)
                continue
            end

            for _, e in ipairs(exits) do
                if not alive or not S.enabled or S.escaped then break end
                if tried[e.model] and tick() - tried[e.model] < 20 then continue end
                waitUnpaused()

                local open = exitIsOpen(e)

                if not open then
                    if isBeastNearby(35) then
                        task.wait(0.5)
                    else
                        setStatus("Opening exit door...")
                        open = exitOpenDoor(e) == "open"
                    end
                end

                if open then
                    setStatus("Escaping...")
                    if exitEscape(e) then
                        S.escaped = true
                        return
                    end
                    tried[e.model] = tick()
                end
            end
        end
    end

    -- ======================================================== BEAST AUTO + SAVE

    local function pods()
        local list = {}
        local map = getMap()
        if not map then return list end
        for _, v in ipairs(MapCache.pods) do
            if v and v.Parent then list[#list + 1] = v end
        end
        return list
    end

    local function podTorso(pod)
        local ct = pod:FindFirstChild("CapturedTorso", true)
        return ct and ct.Value
    end

    local function podTrigger(pod)
        return partOf(pod:FindFirstChild("PodTrigger", true))
    end

    local function isCaptured(torso)
        for _, pod in ipairs(pods()) do
            if podTorso(pod) == torso then return true end
        end
        return false
    end

    local function podInteract(pod, done)
        local root = getRoot()
        local trig = podTrigger(pod)
        if not root or not trig then return false end

        local dir = pod:GetPivot().Position - trig.Position
        dir = dir.Magnitude > 0 and dir.Unit * 3 or Vector3.zero
        local pos = Vector3.new(trig.Position.X + dir.X, trig.Position.Y, trig.Position.Z + dir.Z)

        local result = false
        withNoclip(function()
            root.CFrame = CFrame.new(pos)
            zeroVelocity(root)
            task.wait(0.15)

            local pin = true
            local c = RunService.Heartbeat:Connect(function()
                if pin then
                    pcall(function()
                        root.CFrame = CFrame.new(pos)
                        zeroVelocity(root)
                    end)
                end
            end)

            local t = 0
            while t < 3 do
                touch(root, trig, 0.03)
                action()
                if done() then result = true break end
                task.wait(0.15)
                t += 0.18
            end
            pin = false
            c:Disconnect()
        end)
        return result
    end

    local function nearestEmptyPod(root)
        local best, bestD = nil, math.huge
        for _, pod in ipairs(pods()) do
            local trig = podTrigger(pod)
            if trig and podTorso(pod) == nil then
                local d = (root.Position - trig.Position).Magnitude
                if d < bestD then best, bestD = pod, d end
            end
        end
        return best
    end

    local function isPlayerRagdolled(p, hum)
        local stats = p and p:FindFirstChild("TempPlayerStatsModule")
        local rag = stats and stats:FindFirstChild("Ragdoll")
        if rag and rag.Value == true then return true end
        return hum ~= nil and hum.PlatformStand == true
    end

    local function isPlayerCaptured(p, torso)
        local stats = p and p:FindFirstChild("TempPlayerStatsModule")
        local cap = stats and stats:FindFirstChild("Captured")
        if cap and cap.Value == true then return true end
        return isCaptured(torso)
    end

    local function nearestPlayer(root, filter)
        local best, bestD = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character and isPlayerInMatch(p) then
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                local torso = torsoOf(p.Character)
                if hum and torso and filter(p, hum, torso) then
                    local d = (root.Position - torso.Position).Magnitude
                    if d < bestD then best, bestD = p, d end
                end
            end
        end
        return best
    end

    local function stickToTarget(targetChar, offsetCF, duration, loopBody, breakCond)
        local root = getRoot()
        if not root or not targetChar then return end
        local pin = true
        local conn = RunService.Heartbeat:Connect(function()
            if not pin or not alive or not S.enabled or S.paused then return end
            local r = getRoot()
            local tRoot = targetChar:FindFirstChild("HumanoidRootPart") or torsoOf(targetChar)
            local myChar = player.Character
            if r and tRoot and tRoot.Parent then
                if myChar then
                    for _, part in ipairs(myChar:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
                local targetPos = (tRoot.CFrame * offsetCF).Position
                r.CFrame = CFrame.lookAt(targetPos, tRoot.Position)
                zeroVelocity(r)
            end
        end)
        local t = 0
        while alive and S.enabled and not S.paused and t < duration do
            if breakCond and breakCond() then break end
            if loopBody then loopBody() end
            task.wait(0.12)
            t += 0.12
        end
        pin = false
        conn:Disconnect()
    end

    local function beastLoop()
        while alive do
            task.wait(0.08)
            if not S.enabled or S.paused or not isSelfBeast() then continue end

            if not isGameActive() or phaseHas("HEAD START", "CHUẨN BỊ") then
                setStatus("Beast: waiting for round...")
                task.wait(0.5)
                continue
            end

            local char = player.Character
            local root = getRoot()
            local remote = char and char:FindFirstChild("HammerEvent", true)
            if not remote and char then
                local bp = player:FindFirstChild("Backpack")
                local hm = bp and bp:FindFirstChild("Hammer")
                if hm then
                    local hum = getHum()
                    if hum then pcall(function() hum:EquipTool(hm) end) end
                    remote = hm:FindFirstChild("HammerEvent", true)
                end
            end
            if not remote or not root then continue end

            if char:FindFirstChild("RopeConstraint", true) then
                local pod = nearestEmptyPod(root)
                if not pod then
                    setStatus("Beast: no empty cage!")
                    continue
                end
                setStatus("Beast: caging...")
                podInteract(pod, function() return podTorso(pod) ~= nil end)
                continue
            end

            local ragdoll = nearestPlayer(root, function(p, hum, torso)
                return isPlayerRagdolled(p, hum) and not isPlayerCaptured(p, torso)
            end)
            if ragdoll and ragdoll.Character then
                setStatus("Beast: roping " .. ragdoll.Name)
                stickToTarget(
                    ragdoll.Character,
                    CFrame.new(0, 0, 1.2),
                    2.2,
                    function()
                        local torso = torsoOf(ragdoll.Character)
                        if torso then
                            remote:FireServer("HammerTieUp", torso, torso.Position)
                        end
                    end,
                    function()
                        return char:FindFirstChild("RopeConstraint", true) ~= nil
                            or not ragdoll.Character
                            or isPlayerCaptured(ragdoll, torsoOf(ragdoll.Character))
                    end
                )
                task.wait(0.05)
                continue
            end

            local target = nearestPlayer(root, function(p, hum, torso)
                return not isPlayerRagdolled(p, hum) and not isPlayerCaptured(p, torso)
            end)
            if not target or not target.Character then
                setStatus("Beast: all captured!")
                task.wait(0.8)
                continue
            end

            setStatus("Beast: hitting " .. target.Name)
            stickToTarget(
                target.Character,
                CFrame.new(0, 0, 1.5),
                2.5,
                function()
                    local torso = torsoOf(target.Character)
                    if torso then
                        remote:FireServer("HammerClick", true)
                        task.wait(0.02)
                        remote:FireServer("HammerHit", torso)
                    end
                end,
                function()
                    if not target.Character or not isPlayerInMatch(target) then return true end
                    local h = target.Character:FindFirstChildOfClass("Humanoid")
                    local torso = torsoOf(target.Character)
                    return not h or not torso or isPlayerRagdolled(target, h) or isPlayerCaptured(target, torso)
                end
            )
            task.wait(0.05)
        end
    end

    local function autoSaveLoop()
        while alive do
            task.wait(0.3)
            if not S.enabled or S.paused or isSelfBeast() then continue end
            if S.saves >= CFG.maxSaves or S.moving or S.evading then continue end
            if not isInRound() then continue end

            local root = getRoot()
            if not root then continue end

            for _, pod in ipairs(pods()) do
                local torso = podTorso(pod)
                local trig = podTrigger(pod)
                if torso and trig then
                    local captured
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= player and torsoOf(p.Character) == torso then captured = p break end
                    end
                    if captured then
                        S.saving = true
                        S.moving = true
                        local returnTrigger = S.currentTrigger
                        local jump = S.canJump
                        S.canJump = false
                        setStatus("Saving: " .. captured.Name)

                        local ok = podInteract(pod, function() return podTorso(pod) == nil end)
                        if ok then
                            S.saves += 1
                            setStatus("Saved! Returning to PC...")
                        end

                        local r = getRoot()
                        if returnTrigger and r then
                            local b = findCurrentBeast()
                            local br = b and b.Character and (b.Character:FindFirstChild("HumanoidRootPart") or torsoOf(b.Character))
                            local pcSafe = not (br and (br.Position - returnTrigger.Position).Magnitude <= CFG.beastEvadeDist)
                            if pcSafe then
                                zeroVelocity(r)
                                r.CFrame = returnTrigger.CFrame + Vector3.new(0, 0.5, 0)
                                task.wait(0.15)
                                touch(r, returnTrigger, 0.05)
                                task.wait(0.1)
                                action()
                            elseif S.currentPC and S.currentPC.id then
                                S.skipped[S.currentPC.id] = true
                                stopHack()
                            end
                        end

                        S.canJump = jump
                        S.moving = false
                        S.saving = false
                        break
                    end
                end
            end
        end
    end

    -- ======================================================== CANDY QUEST

    local Candy = {
        enabled = false,
        busy = false,
        lastBag = 0,
        miss = 0,
        initial = false,
    }

    local bagLabel, lastLabelScan = nil, 0
    local bucketCache, lastBucketScan = {}, 0

    local function notify(text)
        task.spawn(showBanner, text, "CandyQuestBanner")
    end



    local function findBagLabel()
        if bagLabel and bagLabel.Parent and tostring(bagLabel.Text):match("%d+%s*/%s*30") then
            return bagLabel
        end
        bagLabel = nil
        if os.clock() - lastLabelScan < 2 then return nil end
        lastLabelScan = os.clock()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        if not pg then return nil end
        for _, g in ipairs(pg:GetDescendants()) do
            if (g:IsA("TextLabel") or g:IsA("TextButton")) and tostring(g.Text):match("%d+%s*/%s*30") then
                bagLabel = g
                return g
            end
        end
        return nil
    end

    local function bagCount()
        local lbl = findBagLabel()
        if lbl then
            local c = tostring(lbl.Text):match("(%d+)%s*/%s*30")
            if c then return tonumber(c) end
        end
        return 0
    end

    local function refreshBuckets()
        bucketCache = {}
        for _, obj in ipairs(MapCache.buckets) do
            if obj and obj.Parent then
                bucketCache[#bucketCache + 1] = obj
            end
        end
        lastBucketScan = os.clock()
    end

    local function scanBuckets()
        for _, obj in ipairs(bucketCache) do
            if obj.Parent then
                local main = obj:FindFirstChild("Main")
                if main and main:IsA("BasePart") and main.Transparency < 1 then
                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt and prompt.Enabled then
                        local cur, max = 0, 100
                        local bb = main:FindFirstChild("BillboardGui")
                        local lbl = bb and bb:FindFirstChild("AmountLabel")
                        if lbl then
                            local c, m = tostring(lbl.Text):match("(%d+)%s*/%s*(%d+)")
                            if c and m then cur, max = tonumber(c), tonumber(m) end
                        end
                        return main, prompt, cur, max
                    end
                end
            end
        end
        return nil
    end

    local function activeBucket()
        if os.clock() - lastBucketScan > 3 then refreshBuckets() end
        local main, prompt, cur, max = scanBuckets()
        if main then return main, prompt, cur, max end
        if os.clock() - lastBucketScan > 1.5 then
            refreshBuckets()
            return scanBuckets()
        end
        return nil
    end

    local function charSafe()
        local char = player.Character
        if not char then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then return false end
        local stats = player:FindFirstChild("TempPlayerStatsModule")
        if stats then
            local ragdoll = stats:FindFirstChild("Ragdoll")
            local captured = stats:FindFirstChild("Captured")
            if (ragdoll and ragdoll.Value == true) or (captured and captured.Value == true) then
                return false
            end
        end
        return true
    end

    local function finishQuest(already)
        Candy.enabled = false
        notify(already and "You already completed the Candy Quest!" or "Candy Quest completed!")
        if API.onCandyDone then API.onCandyDone() end
    end

    local function depositCandy()
        if Candy.busy or S.saving or S.escaping or S.evading or not charSafe() then return end
        local main, prompt, cur, max = activeBucket()
        if not main or not prompt or cur >= max then return end

        Candy.busy = true
        S.paused = true
        task.wait(0.15)

        local root = getRoot()
        if root then
            local oldCF = root.CFrame
            zeroVelocity(root)

            local t0 = os.clock()
            while alive and Candy.enabled and bagCount() > 0 and charSafe() and isPlayerInMatch(player) and not S.saving and not S.escaping and (os.clock() - t0 < 15) do
                local curMain, curPrompt, c, m = activeBucket()
                if not curMain or not curPrompt or c >= m then break end

                local r = getRoot()
                if not r then break end

                zeroVelocity(r)
                r.CFrame = curMain.CFrame * CFrame.new(0, 3, 0)
                task.wait(0.12)

                if fireproximityprompt then
                    pcall(fireproximityprompt, curPrompt)
                else
                    pcall(function()
                        curPrompt:InputHoldBegin()
                        task.wait(curPrompt.HoldDuration + 0.05)
                        curPrompt:InputHoldEnd()
                    end)
                end

                task.wait(0.15)
            end

            local r = getRoot()
            if r then
                zeroVelocity(r)
                r.CFrame = oldCF
            end
            task.wait(0.05)
        end

        S.paused = false

        local trig = S.currentTrigger
        local r = getRoot()
        if S.hacking and trig and r and not isBeastNearby(CFG.beastEvadeDist) then
            r.CFrame = trig.CFrame + Vector3.new(0, 0.5, 0)
            task.wait(0.15)
            touch(r, trig, 0.1)
            task.wait(0.2)
            action()
        end

        Candy.lastBag = bagCount()
        Candy.busy = false
    end

    task.spawn(function()
        while alive do
            task.wait(0.2)
            if not Candy.enabled or Candy.busy then continue end

            if not isPlayerInMatch(player) then
                Candy.miss = 0
                continue
            end

            local bag = bagCount()
            local main, _, cur, max = activeBucket()

            if not main or cur >= max then
                Candy.miss += 1
                local limit = Candy.initial and 8 or 12
                if Candy.miss >= limit then
                    local already = Candy.initial
                    Candy.miss = 0
                    Candy.initial = false
                    finishQuest(already)
                end
            else
                Candy.miss = 0
                Candy.initial = false
                if bag > 0 then
                    depositCandy()
                end
                Candy.lastBag = bagCount()
            end
        end
    end)

    -- ======================================================== MAIN LOOP

    local function pickNextPC()
        local root = getRoot()
        local b = findCurrentBeast()
        local bRoot = b and b.Character and (b.Character:FindFirstChild("HumanoidRootPart") or torsoOf(b.Character))

        local bestPC, bestDist = nil, math.huge
        for _, pcData in ipairs(S.pcs) do
            local id = pcData.id
            local comp = pcData.computer
            if not S.hacked[id] and not S.hacked[comp] and not S.skipped[id] then
                if getPCProgress(pcData) >= 1 then
                    S.hacked[id] = true
                    S.hacked[comp] = true
                else
                    local pPart = partOf(pcData.computer)
                    local beastTooClose = false
                    if bRoot and pPart and (bRoot.Position - pPart.Position).Magnitude <= CFG.beastEvadeDist then
                        beastTooClose = true
                        S.skipped[id] = true
                    end
                    if not beastTooClose and pPart and root then
                        local d = (root.Position - pPart.Position).Magnitude
                        if d < bestDist then
                            bestDist = d
                            bestPC = pcData
                        end
                    elseif not beastTooClose and not bestPC then
                        bestPC = pcData
                    end
                end
            end
        end
        return bestPC
    end

    local function mainLoop()
        while alive do
            waitUnpaused()

            if not S.enabled then
                stopHack()
                S.escaped = false
                S.lastResetMap = nil
                task.wait(0.5)
                continue
            end

            if not waitForRound() then
                task.wait(1)
                continue
            end

            S.round += 1
            resetState()
            S.saves = 0

            if isSelfBeast() then
                setStatus("Beast mode - auto running")
                repeat task.wait(1) until not alive or not S.enabled or not isSelfBeast() or not isInRound()
                continue
            end

            for _ = 1, 10 do
                S.pcs = findAllPCs()
                if #S.pcs >= 4 then break end
                task.wait(0.5)
            end
            if #S.pcs > 0 and #S.pcs < 4 then
                task.wait(1.0)
                S.pcs = findAllPCs()
            end

            if #S.pcs == 0 then
                setStatus("No PCs found in map")
                task.wait(2)
                continue
            end
            setStatus("Found " .. #S.pcs .. " PC(s)")

            while alive and S.enabled and isInRound() and not S.escaped do
                local attempts, maxAttempts = 0, math.max(18, #S.pcs * 6)
                while alive and S.enabled and attempts < maxAttempts
                    and not (isFindExitPhase() and not CFG.hackExtraPC) do

                    waitUnpaused()
                    if not isInRound() or S.escaped then break end

                    if isBeastNearby(CFG.beastEvadeDist) then
                        escapeBeast()
                    end

                    local nextPC = pickNextPC()
                    if nextPC then
                        hackPC(nextPC)
                        attempts += 1
                    else
                        S.pcs = findAllPCs()
                        local unhackedCount = 0
                        for _, pcData in ipairs(S.pcs) do
                            if getPCProgress(pcData) >= 1 then
                                S.hacked[pcData.id] = true
                                S.hacked[pcData.computer] = true
                            end
                            if not S.hacked[pcData.id] and not S.hacked[pcData.computer] then
                                unhackedCount += 1
                            end
                        end

                        if unhackedCount == 0 then
                            break
                        else
                            setStatus("Evading Beast / Waiting for safe PC...")
                            task.wait(1.2)
                            S.skipped = {}
                            attempts += 1
                        end
                    end
                end

                if CFG.hackExtraPC then task.wait(1) end
                cancelCurrentTween()

                if isInRound() and not isFindExitPhase() then
                    setStatus("Waiting for Find Exit...")
                    local t0 = tick()
                    repeat task.wait(0.2)
                    until not alive or not S.enabled or not isInRound() or isFindExitPhase() or tick() - t0 > 15

                    if alive and S.enabled and isInRound() and not isFindExitPhase() then
                        S.pcs = findAllPCs()
                        S.skipped = {}
                        for _, pcData in ipairs(S.pcs) do
                            if not screenDone(pcData.computer) then
                                S.hacked[pcData.id] = nil
                                S.hacked[pcData.computer] = nil
                            end
                        end
                        continue
                    end
                end

                if alive and S.enabled and isInRound() and isFindExitPhase() then
                    setStatus("Auto Exit started!")
                    local ok, err = pcall(runAutoExit)
                    if not ok then warn("[AutoFarm] exit error:", err) end
                    task.wait(2)
                    break
                end

                if not isInRound() or S.escaped then
                    break
                end
            end
        end
    end

