}

local function _cacheAdd(cat, obj)
    if not obj or MapCache._set[cat][obj] then return end
    MapCache._set[cat][obj] = true
    table.insert(MapCache[cat], obj)
end

local function _cacheRemove(cat, obj)
    if not obj or not MapCache._set[cat][obj] then return end
    MapCache._set[cat][obj] = nil
    local list = MapCache[cat]
    for i = #list, 1, -1 do
        if list[i] == obj or not list[i].Parent then
            table.remove(list, i)
        end
    end
end

local function _classifyMapDescendant(obj)
    if not obj or not obj.Parent then return end
    local name = obj.Name
    if name == "ComputerTable" then
        if not obj:GetFullName():lower():find("prefab") then
            _cacheAdd("computers", obj)
        end
    elseif obj:IsA("BasePart") and (name == "ComputerTrigger1" or name == "ComputerTrigger2" or name == "ComputerTrigger3") then
        _cacheAdd("computerTriggers", obj)
        _cacheAdd("allTriggers", obj)
    elseif name == "DoorTrigger" then
        if obj:FindFirstChild("ActionSign") then
            _cacheAdd("doorTriggers", obj)
        end
        if obj:IsA("BasePart") then
            _cacheAdd("allTriggers", obj)
        end
    elseif name == "ActionSign" and obj.Parent and obj.Parent.Name == "DoorTrigger" then
        _cacheAdd("doorTriggers", obj.Parent)
    elseif name == "FreezePod" then
        _cacheAdd("pods", obj)
    elseif name == "ExitDoor" then
        _cacheAdd("exits", obj)
    elseif obj:IsA("BasePart") and string.find(string.lower(name), "ventblock", 1, true) then
        _cacheAdd("vents", obj)
    elseif obj:IsA("Model") and name == "Bucket" then
        _cacheAdd("buckets", obj)
    end

    if obj:IsA("BasePart") and (name:find("Trigger") or obj:FindFirstChild("Event")) then
        _cacheAdd("allTriggers", obj)
    elseif name == "Event" and obj.Parent and obj.Parent:IsA("BasePart") then
        _cacheAdd("allTriggers", obj.Parent)
    end
end

local function _unclassifyMapDescendant(obj)
    if not obj then return end
    for cat in pairs(MapCache._set) do
        if MapCache._set[cat][obj] then
            _cacheRemove(cat, obj)
        end
    end
end

function MapCache.clear()
    for _, c in ipairs(MapCache.mapConns) do
        if typeof(c) == "RBXScriptConnection" then c:Disconnect() end
    end
    MapCache.mapConns = {}
    for cat in pairs(MapCache._set) do
        MapCache[cat] = {}
        MapCache._set[cat] = {}
    end
    MapCache.currentMap = nil
end

function MapCache.rebuild(map)
    MapCache.clear()
    map = map or (Replicated:FindFirstChild("CurrentMap") and Replicated.CurrentMap.Value)
    if not map or not map.Parent then return end
    MapCache.currentMap = map

    for _, desc in ipairs(map:GetDescendants()) do
        _classifyMapDescendant(desc)
    end

    table.insert(MapCache.mapConns, map.DescendantAdded:Connect(function(desc)
        _classifyMapDescendant(desc)
    end))
    table.insert(MapCache.mapConns, map.DescendantRemoving:Connect(function(desc)
        _unclassifyMapDescendant(desc)
    end))
end

function MapCache.stop()
    MapCache.clear()
    for _, c in ipairs(MapCache.connections) do
        if typeof(c) == "RBXScriptConnection" then c:Disconnect() end
    end
    MapCache.connections = {}
end

