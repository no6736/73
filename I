    local st = lp:FindFirstChild("TempPlayerStatsModule")
    if st then bindStats(st) end
    table.insert(NeverFailController.connections, lp.ChildAdded:Connect(function(ch)
        if ch.Name == "TempPlayerStatsModule" then
            bindStats(ch)
