local TrackedMapHighlights = {}

local function registerMapHighlight(hl)
    if not hl then return hl end
    for _, existing in ipairs(TrackedMapHighlights) do
        if existing == hl then return hl end
    end
    table.insert(TrackedMapHighlights, hl)
