            if ok and raw and raw ~= "" and raw ~= "null" then
                local decodeOk, data = pcall(function()
                    return HttpService:JSONDecode(raw)
                end)

                if decodeOk and type(data) == "table" and data.timestamp and data.message then
                    local ts = tonumber(data.timestamp) or 0
                    if lastTimestamp == nil then
                        lastTimestamp = ts
                        -- Nếu tin nhắn vừa được admin gửi trong vòng 60 giây gần nhất thì hiện ngay khi bật script
                        if (os.time() - ts) <= 60 then
                            showAdminBanner(data.sender or "Dark •", data.message)
                        end
                    elseif ts > lastTimestamp then
                        lastTimestamp = ts
                        showAdminBanner(data.sender or "Dark •", data.message)
                    end
                end
            end

