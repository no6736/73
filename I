        if remSec <= 0 then
            return "0d 0h 0m 0s (Expired)"
        end
        local d = math.floor(remSec / 86400)
        local h = math.floor((remSec % 86400) / 3600)
        local m = math.floor((remSec % 3600) / 60)
        local s = math.floor(remSec % 60)
        return string.format("%dd %dh %dm %ds", d, h, m, s)
    end

    local rawExpire = getgenv().JD_EXPIRES_AT
    local expireUnix = tonumber(rawExpire)
    if expireUnix and expireUnix > 100000000000 then
        expireUnix = math.floor(expireUnix / 1000)
    end

    if expireUnix and expireUnix > 0 then
        local initRem = math.max(0, math.floor(expireUnix - os.time()))
        TypeGlitch(Ex, "---- Expires: " .. formatCountdown(initRem), TEXT_SPEED)
        task.spawn(function()
            while SG and SG.Parent and Ex and Ex.Parent do
                local rem = math.max(0, math.floor(expireUnix - os.time()))
                Ex.Text = "---- Expires: " .. formatCountdown(rem)
                if rem <= 0 then
                    Ex.TextColor3 = Color3.fromRGB(255, 80, 80)
                    break
                end
                task.wait(1)
            end
        end)
